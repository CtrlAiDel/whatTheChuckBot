{
  "keywords": [],
  "main": "index.js",
  "name": "WhatTheChuckBot",
  "version": "1.0.0",
  "description": "A Discord® Application",
  "author": "RVÐ",
  "license": "ISC",
  "assets": "./assets",
  "scripts": {
    "uglify": "node ./gulp/main.js",
    "watch": "npm run build && tsc -w",
    "clean": "rm -rf dist node_modules package-lock.json",
    "build": "rm -rf dist && npm i && tsc && npm run copyExtraFiles",
    "start": "npm run clean && npm run build && npm run nodeSource",
    "nodeDist": "node ./dist/src/index.js",
    "nodeSource": "ts-node ./src/index.ts",
    "copyExtraFiles": "cp -rf ./api/certs -t ./dist/api && cp -rf ./assets -t ./dist",
    "clear-branches": "git branch | xargs git branch -D",
    "sentry:ci": "sentry-cli sourcemaps inject --org rvdprojects --project what-the-chuck ./dist && sentry-cli sourcemaps upload --org rvdprojects --project what-the-chuck ./dist"
  },
  "dependencies": {
    "@fabricio-191/valve-server-query": "latest",
    "@sentry/cli": "latest",
    "@sentry/node": "latest",
    "cors": "latest",
    "discord-canvas": "latest",
    "discord.js": "latest",
    "dotenv": "latest",
    "express-session": "latest",
    "express-validator": "latest",
    "fs": "latest",
    "fs-extra": "latest",
    "glob": "latest",
    "helmet": "latest",
    "https": "latest",
    "mongodb": "latest",
    "node-fetch": "latest",
    "openai": "latest",
    "pino": "latest",
    "WhatTheChuckBot": "file:",
    "youtubei.js": "latest"
  },
  "devDependencies": {
    "@babel/core": "latest",
    "@types/express": "latest",
    "@types/glob": "latest",
    "@types/jquery": "latest",
    "@types/node": "latest",
    "express": "latest",
    "gulp": "latest",
    "gulp-babel": "latest",
    "gulp-concat": "latest",
    "gulp-uglify": "latest",
    "ts-node": "latest",
    "ts-node-dev": "latest",
    "typescript": "latest",
    "uglify-js": "latest"
  }
}